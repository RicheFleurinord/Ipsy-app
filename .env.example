# Copier en .env.local (local) ou saisir dans Vercel → Settings → Environment Variables.
# Ne JAMAIS committer de vraie clé.

# Fournisseur principal : gemini (recommandé) ou groq. L'autre sert de secours s'il a une clé.
AI_PROVIDER=gemini

# Google Gemini API — clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq (API compatible OpenAI) — clé gratuite : https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
